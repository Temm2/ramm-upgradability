// ─── Campaign Disbursement ────────────────────────────────────────────────────

const USDC_TRANSFER_ABI = [
  {
    name: "transfer",
    type: "function",
    stateMutability: "nonpayable",
    inputs: [{ name: "to", type: "address" }, { name: "amount", type: "uint256" }],
    outputs: [{ name: "", type: "bool" }],
  },
  {
    name: "balanceOf",
    type: "function",
    stateMutability: "view",
    inputs: [{ name: "account", type: "address" }],
    outputs: [{ name: "", type: "uint256" }],
  },
] as const

/**
 * Disburse pending promoter earnings from the campaignWallet.
 *
 * Flow:
 *  1. Read campaignWallet on-chain USDC balance.
 *  2. Calculate each promoter's share from pending attributions.
 *  3. Send USDC to each promoter wallet via campaignWallet private key.
 *  4. Mark attributions as disbursed.
 *
 * Platform share stays in campaignWallet (VALET drains it separately).
 * Called by brand from dashboard or auto-triggered after sell events.
 */
export async function disburseCampaign(campaignId: string): Promise<{
  disbursements: { promoterRef: string; usdcSent: string }[]
  totalSent: string
  remainingBalance: string
}> {
  const rec = getCampaign(campaignId)
  if (!rec) throw new Error("Campaign not found")
  if (!rec.campaignPrivateKey) throw new Error("No campaign wallet key — cannot disburse")

  const account = privateKeyToAccount(rec.campaignPrivateKey as Hex)
  const walletClient = createWalletClient({ account, chain: baseSepolia, transport: http(RPC_URL) })
  const publicClient = createPublicClient({ chain: baseSepolia, transport: http(RPC_URL) })

  if (!USDC_ADDRESS) throw new Error("USDC_ADDRESS not configured")

  // Read on-chain balance
  const balance = await publicClient.readContract({
    address: USDC_ADDRESS,
    abi: USDC_TRANSFER_ABI,
    functionName: "balanceOf",
    args: [rec.campaignWallet],
  }) as bigint

  const earnings = getPromoterEarnings(campaignId, rec.buyPromoterRateBps)
  if (earnings.length === 0) return { disbursements: [], totalSent: "0", remainingBalance: String(balance) }

  const totalNeeded = earnings.reduce((sum, e) => sum + e.earnedUsdc, 0n)
  if (totalNeeded > balance) throw new Error(
    `Insufficient campaignWallet balance: need ${totalNeeded} USDC wei, have ${balance}`
  )

  const disbursements: { promoterRef: string; usdcSent: string }[] = []
  let totalSent = 0n
  let nonce = await publicClient.getTransactionCount({ address: account.address, blockTag: "pending" })
  const pendingIds = getPendingAttributions(campaignId).map((a) => a.id)

  for (const { promoterRef, earnedUsdc } of earnings) {
    if (earnedUsdc === 0n) continue
    const hash = await walletClient.writeContract({
      address: USDC_ADDRESS,
      abi: USDC_TRANSFER_ABI,
      functionName: "transfer",
      args: [promoterRef as Address, earnedUsdc],
      nonce: nonce++,
    })
    await publicClient.waitForTransactionReceipt({ hash })
    markDisbursed(pendingIds, hash)
    disbursements.push({ promoterRef, usdcSent: String(earnedUsdc) })
    totalSent += earnedUsdc
  }

  const remaining = balance - totalSent
  return { disbursements, totalSent: String(totalSent), remainingBalance: String(remaining) }
}

export function addSecretCodes(campaignId: string, codes: string[]): { added: number; total: number } {
  const rec = getCampaign(campaignId)
  if (!rec) throw new Error("Campaign not found")

  // Merge new codes with any already in the vault
  const existing = readVaultCodes(campaignId)
  const merged = [...existing, ...codes]
  depositCodes(campaignId, merged)

  saveCampaign({ ...rec, secretCodeCount: merged.length })
  return { added: codes.length, total: merged.length }
}

// ─── Queries ──────────────────────────────────────────────────────────────────

export function listCampaigns(brandDid: string) {
  return getCampaignsByBrand(brandDid).map((c) => ({
    ...c,
    remainingCodes: remainingCodes(c.campaignId),
  }))
}

export function getCampaignDetail(campaignId: string) {
  const c = getCampaign(campaignId)
  if (!c) return null
  return { ...c, remainingCodes: remainingCodes(campaignId) }
}

// Public, no-auth catalog endpoint — must never leak the campaign wallet's
// private key (campaignPrivateKey), unlike getCampaignDetail/listCampaigns
// which sit behind requireBrandAuth and are scoped to the owning brand.
export function listAllCampaigns() {
  return getAllCampaigns().map(({ campaignPrivateKey: _campaignPrivateKey, ...c }) => ({
    ...c,
    remainingCodes: remainingCodes(c.campaignId),
  }))
}

