  },
] as const

// RedemptionNFT and RAMMToken are shared across every product's market, so each
// newly deployed market must be explicitly authorized on both — see
// contracts/src/RedemptionNFT.sol / RAMMToken.sol (authorizedMarkets/authorizedMinters).
const SET_MARKET_AUTHORIZED_ABI = [
  {
    name: "setMarketAuthorized",
    type: "function",
    stateMutability: "nonpayable",
    inputs: [{ name: "_market", type: "address" }, { name: "_authorized", type: "bool" }],
    outputs: [],
  },
] as const

