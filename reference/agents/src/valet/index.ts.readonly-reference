// ─── Contract bytecodes (from compiled Foundry artifacts) ─────────────────────

const __dir = path.dirname(fileURLToPath(import.meta.url))

function loadBytecode(contractName: string): Hex {
  const artifactPath = path.resolve(
    __dir,
    `../../../contracts/out/${contractName}.sol/${contractName}.json`
  )
  const artifact = JSON.parse(readFileSync(artifactPath, "utf8"))
  return artifact.bytecode.object as Hex
}

// ─── Auth Nonces (in-memory; V2: Redis) ──────────────────────────────────────

const pendingNonces = new Map<string, { nonce: string; expiresAt: number }>()

export function generateAuthChallenge(domain: string): string {
  const nonce = crypto.randomBytes(16).toString("hex")
  pendingNonces.set(domain, { nonce, expiresAt: Date.now() + 5 * 60 * 1000 })
  return nonce
}

export async function verifyBrandAuth(
  domain: string,
  walletAddress: Address,
  signature: Hex
): Promise<string> {
  const entry = pendingNonces.get(domain)
  if (!entry) throw new Error("No pending challenge for this domain. Request one first.")
  if (Date.now() > entry.expiresAt) {
    pendingNonces.delete(domain)
    throw new Error("Challenge expired. Request a new one.")
  }

  const message = `RAMM Brand Auth\nDomain: ${domain}\nNonce: ${entry.nonce}`
  const recovered = await recoverMessageAddress({ message, signature })
  if (recovered.toLowerCase() !== walletAddress.toLowerCase()) {
    throw new Error("Signature does not match the provided wallet address.")
  }

  pendingNonces.delete(domain)

  // Issue JWT — stub for X.402 Verifiable Credential
  const token = jwt.sign(
    { did: `did:web:${domain}`, wallet: walletAddress },
    JWT_SECRET,
    { expiresIn: "24h" }
  )
  return token
}

export function verifyJWT(token: string): { did: string; wallet: Address } {
  const payload = jwt.verify(token, JWT_SECRET) as { did: string; wallet: Address }
  return payload
}

/**
 * Simplified signup for the email/password brand UI — no wallet connection
 * required. Generates (or reuses) a custodial wallet for the brand and issues
 * the same JWT shape the wallet-signature flow produces, so downstream code
 * (createCampaign, requireBrandAuth) doesn't need to know which path was used.
 */
export function signupBrand(params: { email: string; brandName: string; website: string }): { token: string; did: string; wallet: Address } {
  const brand = signupOrLoginBrand(params)
  const token = jwt.sign({ did: brand.did, wallet: brand.wallet }, JWT_SECRET, { expiresIn: "30d" })
  return { token, did: brand.did, wallet: brand.wallet }
}

// ─── Campaign Deployment ──────────────────────────────────────────────────────

export interface CreateCampaignParams {
  brandDid: string
  brandWallet: Address
  productName: string
  symbol: string
  totalSupply: number
  basePriceUsdc: number        // price at sigmoid inflection ($, e.g. 1000)
  // Fee policy — defaults: buy 6%/1%, sell 3%/0.5%
  buyPromoterRateBps?: number  // e.g. 600 = 6%
  buyPlatformRateBps?: number  // e.g. 100 = 1%
  sellPromoterRateBps?: number // e.g. 300 = 3%
  sellPlatformRateBps?: number // e.g. 50 = 0.5%
  affiliateRateBps: number     // e.g. 700 = 7%
  secretCodes: string[]        // promo codes → encrypted vault
  productDescription: string
  imageUrl: string
  checkoutUrl: string          // brand checkout page where shoppers paste their code
  startsAt?: number           // unix ms — when the drop opens (defaults to now)
  endsAt?: number             // unix ms — when the drop closes
  timezone?: string           // IANA zone the brand picked — display only, startsAt is not zone-aware yet
  dppData?: import("./store.js").DppData
  // Display / brand-intent metadata — see the matching comment on CampaignRecord.
  maxPriceUsdc?: number
  curveShape?: "fast" | "medium" | "slow"
  targetLocation?: string
  fulfillmentMethod?: "warehouse" | "3pl"
  rewardsEnabled?: boolean
  rewardMode?: "percent" | "fixed"
  tryOnEnabled?: boolean
  garmentRequirements?: string
}

export async function createCampaign(params: CreateCampaignParams): Promise<{
  campaignId: string
  pvtAddress: Address
  marketAddress: Address
  deployTxHash: string
}> {
  if (!DEPLOYER_KEY) throw new Error("DEPLOYER_PRIVATE_KEY not set in agents/.env")
  if (!USDC_ADDRESS) throw new Error("USDC_ADDRESS not set in agents/.env")

  const account = privateKeyToAccount(DEPLOYER_KEY)
  const walletClient = createWalletClient({
    account,
    chain: baseSepolia,
    transport: http(RPC_URL),
  })
  const publicClient = createPublicClient({
    chain: baseSepolia,
    transport: http(RPC_URL),
  })

  // Generate a dedicated custodial wallet for this campaign.
  // Receives 7% of each buy and 2% of each sell (promoter distribution).
  // V2: replace with HSM-backed key management.
  const campaignPrivateKey = generatePrivateKey()
  const campaignAccount = privateKeyToAccount(campaignPrivateKey)
  const campaignWallet = campaignAccount.address

  const pvtBytecode   = loadBytecode("PVTToken")
  const marketBytecode = loadBytecode("IMPXMarket")

  // Track the nonce ourselves rather than relying on automatic "pending"
  // lookups for each call — Alchemy's shared RPC nodes can lag a beat
  // behind each other, so a "pending" count fetched right after the
  // previous tx was broadcast can come back stale and collide with it
  // ("replacement transaction underpriced" on the 3rd/transferOwnership tx).
  let nonce = await publicClient.getTransactionCount({ address: account.address, blockTag: "pending" })

  // 1 — Deploy PVTToken
  // Explicit gas avoids eth_estimateGas round-trip that can fail on Alchemy
  // Base Sepolia nodes when the chain is busy or has stale state.
  let pvtHash: `0x${string}`
  try {
    pvtHash = await walletClient.deployContract({
      abi: PVT_DEPLOY_ABI,
      bytecode: pvtBytecode,
      gas: 1_500_000n,
      nonce: nonce++,
      args: [
        params.productName,
        params.symbol,
        BigInt(params.totalSupply),
        account.address,
      ],
    })
  } catch (err) {
    throw new Error(`[VALET] Step 1 — PVTToken deploy failed: ${String(err)}`)
  }

  const pvtReceipt = await publicClient.waitForTransactionReceipt({ hash: pvtHash })
  if (pvtReceipt.status === "reverted") throw new Error("[VALET] Step 1 — PVTToken deploy reverted on-chain")
  const pvtAddress = pvtReceipt.contractAddress!

  // Fee policy — apply defaults if brand didn't specify
  const buyPromoterRateBps  = params.buyPromoterRateBps  ?? 600
  const buyPlatformRateBps  = params.buyPlatformRateBps  ?? 100
  const sellPromoterRateBps = params.sellPromoterRateBps ?? 300
  const sellPlatformRateBps = params.sellPlatformRateBps ?? 50
  // Contract BPS: buy splits must sum to 10000; sell splits ≤ 10000
  const buyBrandBps    = 10_000 - buyPromoterRateBps - buyPlatformRateBps  // e.g. 9300
  const buyCampaignBps = buyPromoterRateBps + buyPlatformRateBps            // e.g. 700
  const sellBrandBps   = sellPromoterRateBps + sellPlatformRateBps          // e.g. 350 total to campaign (split off-chain)
  const sellCampaignBps = 0  // seller deduction goes to campaignWallet for off-chain distribution

  // Bonding curve shape — was five constants shared by every market
  // regardless of this campaign's own supply cap or the brand's chosen
  // fast/medium/slow shape (captured above only for display until now).
  // See agents/src/valet/curve.ts for the derivation.
  const curve = deriveCurveParams(
    params.basePriceUsdc,
    params.maxPriceUsdc ?? params.basePriceUsdc,
    params.totalSupply,
    params.curveShape ?? "medium"
  )

  // 2 — Deploy IMPXMarket
  let marketHash: `0x${string}`
  try {
    marketHash = await walletClient.deployContract({
      abi: MARKET_DEPLOY_ABI,
      bytecode: marketBytecode,
      gas: 3_000_000n,
      nonce: nonce++,
      args: [
        USDC_ADDRESS,
        pvtAddress,
        REGISTRY_ADDRESS || ZERO_ADDRESS,
        params.brandWallet,
        campaignWallet,
        account.address,
        buyBrandBps,
        buyCampaignBps,
        sellBrandBps,
        sellCampaignBps,
        buyPromoterRateBps,
        curve,
      ],
    })
  } catch (err) {
    throw new Error(`[VALET] Step 2 — IMPXMarket deploy failed: ${String(err)}`)
  }

  const marketReceipt = await publicClient.waitForTransactionReceipt({ hash: marketHash })
  if (marketReceipt.status === "reverted") throw new Error("[VALET] Step 2 — IMPXMarket deploy reverted on-chain")
  const marketAddress = marketReceipt.contractAddress!

  // 3 — Transfer PVT ownership to IMPXMarket so it can mint
  let transferHash: `0x${string}`
  try {
    transferHash = await walletClient.writeContract({
      address: pvtAddress,
      abi: PVT_TRANSFER_ABI,
      functionName: "transferOwnership",
      gas: 100_000n,
      nonce: nonce++,
      args: [marketAddress],
    })
  } catch (err) {
    throw new Error(`[VALET] Step 3 — transferOwnership failed: ${String(err)}`)
  }
  const transferReceipt = await publicClient.waitForTransactionReceipt({ hash: transferHash })
  if (transferReceipt.status === "reverted") throw new Error("[VALET] Step 3 — transferOwnership reverted on-chain")

  // 3a — Authorize this market on the shared RedemptionNFT + RAMMToken + VestingVault
  // contracts. Without this, redemptions/reward mints/referral credits for this
  // product would silently or loudly fail forever — this must happen for every
  // single campaign, not once.
  if (REDEMPTION_NFT_ADDRESS) {
    const authNftHash = await walletClient.writeContract({
      address: REDEMPTION_NFT_ADDRESS,
      abi: SET_MARKET_AUTHORIZED_ABI,
      functionName: "setMarketAuthorized",
      gas: 100_000n,
      nonce: nonce++,
      args: [marketAddress, true],
    })
    const authNftReceipt = await publicClient.waitForTransactionReceipt({ hash: authNftHash })
    if (authNftReceipt.status === "reverted") throw new Error("[VALET] Step 3a — RedemptionNFT authorization reverted on-chain")
  }
  if (RAMM_TOKEN_ADDRESS) {
    const authRammHash = await walletClient.writeContract({
      address: RAMM_TOKEN_ADDRESS,
      abi: SET_MINTER_AUTHORIZED_ABI,
      functionName: "setMinterAuthorized",
      gas: 100_000n,
      nonce: nonce++,
      args: [marketAddress, true],
    })
    const authRammReceipt = await publicClient.waitForTransactionReceipt({ hash: authRammHash })
    if (authRammReceipt.status === "reverted") throw new Error("[VALET] Step 3a — RAMMToken authorization reverted on-chain")
  }
  if (VESTING_VAULT_ADDRESS) {
    const authVaultHash = await walletClient.writeContract({
      address: VESTING_VAULT_ADDRESS,
      abi: SET_MARKET_AUTHORIZED_ABI,
      functionName: "setMarketAuthorized",
      gas: 100_000n,
      nonce: nonce++,
      args: [marketAddress, true],
    })
    const authVaultReceipt = await publicClient.waitForTransactionReceipt({ hash: authVaultHash })
    if (authVaultReceipt.status === "reverted") throw new Error("[VALET] Step 3a — VestingVault authorization reverted on-chain")
  }

  // 3b — Seed buyback liquidity pool (10,000 USDC).
  // Buy proceeds route out immediately to brandWallet/campaignWallet, so the
  // contract needs a pre-funded USDC reserve for sellbacks.
  // On testnet (MockUSDC) we mint directly; on mainnet the deployer must hold USDC.
  const SEED_USDC = 10_000n * 1_000_000n // 10,000 USDC (6 decimals)
  // Use a fresh nonce snapshot for the seed block — if any earlier step burned
  // an extra nonce (e.g. a gas-estimation pre-call), this re-sync keeps us correct.
  const seedNonce = await publicClient.getTransactionCount({ address: account.address, blockTag: "pending" })
  let seedN = seedNonce
  try {
    // Try testnet mint — silently skip if contract doesn't have mint() (mainnet USDC)
    const mintHash = await walletClient.writeContract({
      address: USDC_ADDRESS,
      abi: MOCK_USDC_MINT_ABI,
      functionName: "mint",
      gas: 100_000n,
      nonce: seedN++,
      args: [account.address, SEED_USDC],
    })
    await publicClient.waitForTransactionReceipt({ hash: mintHash })

    const approveHash = await walletClient.writeContract({
      address: USDC_ADDRESS,
      abi: ERC20_ABI,
      functionName: "approve",
      gas: 100_000n,
      nonce: seedN++,
      args: [marketAddress, SEED_USDC],
    })
    await publicClient.waitForTransactionReceipt({ hash: approveHash })

    const depositHash = await walletClient.writeContract({
      address: marketAddress,
      abi: DEPOSIT_LIQUIDITY_ABI,
      functionName: "depositLiquidity",
      gas: 100_000n,
      nonce: seedN++,
      args: [SEED_USDC],
    })
    await publicClient.waitForTransactionReceipt({ hash: depositHash })
  } catch {
    // Non-fatal: mainnet USDC has no mint(); brand must fund via depositLiquidity manually
    console.warn(`[VALET] Could not auto-seed liquidity for ${marketAddress} — fund manually via depositLiquidity()`)
  }

  // 4 — Store campaign metadata (stub for ICP canister)
  const campaignId = crypto.randomUUID()
  const dppData = params.dppData ?? { sustainabilityClaims: [], certifications: [], materials: [], mediaAssets: [] }

  saveCampaign({
    campaignId,
    brandDid: params.brandDid,
    brandWallet: params.brandWallet,
    campaignWallet,
    campaignPrivateKey,
    productName: params.productName,
    symbol: params.symbol,
    totalSupply: params.totalSupply,
    basePriceUsdc: params.basePriceUsdc,
    affiliateRateBps: params.affiliateRateBps,
    pvtAddress,
    marketAddress,
    deployTxHash: marketHash,
    deployedAt: Date.now(),
    startsAt: params.startsAt,
    endsAt: params.endsAt,
    timezone: params.timezone,
    status: "active",
    productDescription: params.productDescription,
    imageUrl: params.imageUrl,
    secretCodeCount: params.secretCodes.length,
    redeemedCount: 0,
    checkoutUrl: params.checkoutUrl ?? "",
    dppData,
    buyPromoterRateBps,
    buyPlatformRateBps,
    sellPromoterRateBps,
    sellPlatformRateBps,
    maxPriceUsdc: params.maxPriceUsdc,
    curveShape: params.curveShape,
    targetLocation: params.targetLocation,
    fulfillmentMethod: params.fulfillmentMethod,
    rewardsEnabled: params.rewardsEnabled,
    rewardMode: params.rewardMode,
    tryOnEnabled: params.tryOnEnabled,
    garmentRequirements: params.garmentRequirements,
  })

  // Pre-warm the vision-based color/style annotation in the background so
  // shoppers rarely hit the un-annotated gap — never blocks campaign creation.
  prewarmAnnotation(campaignId, params.imageUrl)

  // 5 — Deposit secret codes into vault (stub for ICP Swiss Subnet)
  if (params.secretCodes.length > 0) {
    depositCodes(campaignId, params.secretCodes)
  }

  // 6 — Issue and store DPP Verifiable Credential (non-blocking — don't fail deploy on VC error)
  storeDpp(campaignId, dppData, params.brandDid, campaignWallet, campaignPrivateKey)
    .then(({ cid }) => {
      const rec = getCampaign(campaignId)
      if (rec) saveCampaign({ ...rec, dppCid: cid })
      console.log(`[VALET] DPP VC issued for campaign ${campaignId}, CID: ${cid}`)
    })
    .catch((err) => console.warn(`[VALET] DPP VC issuance failed (non-fatal):`, err))

  return { campaignId, pvtAddress, marketAddress, deployTxHash: marketHash }
}

// ─── Fulfillment (RIDIM will call this) ───────────────────────────────────────

/**
 * Release one secret promo code for a verified redemption.
 * V2: RIDIM sends Threshold ECDSA request to ICP Swiss Subnet which
 * verifies the burn proof before releasing. Here we trust the caller (gateway auth).
 */
export function fulfillRedemption(campaignId: string, agentId: AgentId | "UNKNOWN" = "UNKNOWN"): string {
  const code = claimCode(campaignId)
  if (!code) throw new Error("No remaining secret codes for this campaign.")

  const rec = getCampaign(campaignId)
  const redeemedCount = (rec?.redeemedCount ?? 0) + 1
  const willSellOut = rec != null && redeemedCount >= rec.secretCodeCount
  matrix.writeFields(
    "Campaign",
    campaignId,
    { redeemedCount, ...(willSellOut ? { status: "sold_out" as const } : {}) },
    agentId,
  )

  return code
}

