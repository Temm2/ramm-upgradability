# ── RPC ─────────────────────────────────────────────────────────────────────
BASE_SEPOLIA_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<YOUR_ALCHEMY_KEY>

# ── Pimlico ──────────────────────────────────────────────────────────────────
PIMLICO_API_KEY=<YOUR_PIMLICO_API_KEY>
# Optional: Pimlico sponsorship policy for gas sponsorship.
# Leave blank on testnet to use Pimlico's free Base Sepolia sponsorship.
PIMLICO_SPONSORSHIP_POLICY_ID=

# ── Voyage AI (SHOPi semantic search) ───────────────────────────────────────
# Optional. Anthropic has no first-party embeddings API and recommends Voyage
# as its embeddings partner. Without this set, SHOPi's search falls back to
# the regex/keyword pre-filter it always had — nothing breaks, it just won't
# semantically rank products outside the hand-written CAT_TERMS/HEEL_TERMS
# tables in agents/src/shopi/chat.ts. Free tier at voyageai.com.
VOYAGE_API_KEY=

# ── Signer ───────────────────────────────────────────────────────────────────
# ECDSA private key for MVP1 testnet signer.
# V2: replaced by WebAuthn passkey credential (no private key needed on-device).
BUYER_PRIVATE_KEY=0x...

# ── Contract Addresses (filled after `forge script Deploy.s.sol`) ─────────────
USDC_ADDRESS=
PVT_ADDRESS=
MARKET_ADDRESS=
